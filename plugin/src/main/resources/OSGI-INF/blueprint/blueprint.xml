<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:cm="http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.1.0"
           xsi:schemaLocation="http://www.osgi.org/xmlns/blueprint/v1.0.0
		http://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd
		http://aries.apache.org/blueprint/xmlns/blueprint-cm/v1.1.0
		http://aries.apache.org/schemas/blueprint-cm/blueprint-cm-1.1.0.xsd">

    <!-- Configuration properties -->
    <cm:property-placeholder id="prometheusPluginProperties" persistent-id="org.opennms.plugins.tss.prometheus" update-strategy="reload">
        <cm:default-properties>
            <cm:property name="writeUrl" value="http://localhost:9009/api/prom/push" />
            <cm:property name="readUrl" value="http://localhost:9009/prometheus/api/v1" />
            <cm:property name="maxConcurrentHttpConnections" value="100" />
            <cm:property name="writeTimeoutInMs" value="5000" />
            <cm:property name="readTimeoutInMs" value="5000" />
            <cm:property name="metricCacheSize" value="1000" />
            <cm:property name="externalTagsCacheSize" value="1000" />
            <cm:property name="bulkheadMaxWaitDuration" value="9223372036854775807" />
            <cm:property name="maxSeriesLookback" value="7776000" />
            <cm:property name="organizationId" value="" />
            <cm:property name="callTimeoutInMs" value="10000" />
            <cm:property name="asyncWrites" value="false" />
        </cm:default-properties>
    </cm:property-placeholder>

    <bean id="cortexTssConfig" class="org.opennms.timeseries.cortex.CortexTSSConfig">
        <argument value="${writeUrl}" />
        <argument value="${readUrl}" />
        <argument value="${maxConcurrentHttpConnections}" />
        <argument value="${writeTimeoutInMs}" />
        <argument value="${readTimeoutInMs}" />
        <argument value="${metricCacheSize}" />
        <argument value="${externalTagsCacheSize}" />
        <argument value="${bulkheadMaxWaitDuration}" />
        <argument value="${maxSeriesLookback}" />
        <argument value="${organizationId}" />
        <argument value="${callTimeoutInMs}" />
        <argument value="${asyncWrites}" />
    </bean>

    <!--Key-value store -->
    <reference id="keyValueStore" interface="org.opennms.integration.api.v1.distributed.KeyValueStore"/>

    <!-- ConfigurationAdmin, used by the REST API to read/write the plugin config PID -->
    <reference id="configAdmin" interface="org.osgi.service.cm.ConfigurationAdmin"/>

    <bean id="timeSeriesStorage" class="org.opennms.timeseries.cortex.CortexTSS" destroy-method="destroy">
        <argument ref="cortexTssConfig" />
        <argument ref="keyValueStore" />
    </bean>

    <service ref="timeSeriesStorage" interface="org.opennms.timeseries.cortex.CortexTSS" />
    <service ref="timeSeriesStorage" interface="org.opennms.integration.api.v1.timeseries.TimeSeriesStorage">
        <service-properties>
            <entry key="registration.export" value="true" />
        </service-properties>
    </service>

    <!-- REST API — registered with application-path="/rest" so OpenNMS's JAX-RS
         dispatcher exposes it at /opennms/rest/prometheus-remotewrite/...
         The storage bean is passed directly (it is a concrete class, which blueprint
         cannot proxy as an optional service reference). The REST layer still guards
         every use of it via isTssActive(), and /health works regardless. -->
    <bean id="restService" class="org.opennms.timeseries.cortex.rest.PrometheusRemoteWriteRestService">
        <argument ref="configAdmin" />
        <argument ref="timeSeriesStorage" />
    </bean>
    <service ref="restService"
             interface="org.opennms.timeseries.cortex.rest.PrometheusRemoteWriteRestService">
        <service-properties>
            <entry key="application-path" value="/rest" />
        </service-properties>
    </service>

    <!-- UI extension — OpenNMS reads getResourceRootPath()/getModuleFileName()
         and serves the built Vue module from this bundle's classpath. -->
    <service interface="org.opennms.integration.api.v1.ui.UIExtension">
        <bean class="org.opennms.timeseries.cortex.ui.PrometheusRemoteWriteUIExtension"/>
    </service>
</blueprint>
